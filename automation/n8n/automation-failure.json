{
  "id": "crm-automation-failure",
  "name": "CRM - Automation Failure",
  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Automation failed",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: `❌ CRM automation failed\\nWorkflow: ${$json.workflow?.name ?? 'unknown'}\\nError: ${$json.execution?.error?.message ?? 'unknown error'}\\nExecution: ${$json.execution?.id ?? 'unknown'}` }) }}",
        "options": {}
      },
      "id": "discord-failure-notification",
      "name": "Notify Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Automation failed": { "main": [[{ "node": "Notify Discord", "type": "main", "index": 0 }]] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "versionId": "crm-automation-failure-v1",
  "tags": []
}
